<Application
    x:Class="Schoology.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WinUI 3's default templates, styles, and control resources must be
             loaded explicitly by unpackaged apps before controls are created. -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SchoologyBlueBrush" Color="#FF2E66A3" />
          <SolidColorBrush x:Key="SchoologyBlueDarkBrush" Color="#FF204D7B" />
          <SolidColorBrush x:Key="SchoologySurfaceBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="SchoologySubtleBrush" Color="#FFF2F5F7" />
          <SolidColorBrush x:Key="SchoologyDividerBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="SchoologyTextBrush" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="SchoologyMutedTextBrush" Color="#FF666666" />
          <SolidColorBrush x:Key="SchoologyWarningTextBrush" Color="#FFB36A12" />
          <SolidColorBrush x:Key="SchoologySuccessTextBrush" Color="#FF287A3D" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#FF666666" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF596875" />
          <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF666666" />
          <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF777777" />
          <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF999999" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FFB8B8B8" />
          <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#FF777777" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FFD0D0D0" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFF7F7F7" />
          <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FFF2F5F7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SchoologyBlueBrush" Color="#FF5B9BD5" />
          <SolidColorBrush x:Key="SchoologyBlueDarkBrush" Color="#FF183A5B" />
          <SolidColorBrush x:Key="SchoologySurfaceBrush" Color="#FF202428" />
          <SolidColorBrush x:Key="SchoologySubtleBrush" Color="#FF292F34" />
          <SolidColorBrush x:Key="SchoologyDividerBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="SchoologyTextBrush" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="SchoologyMutedTextBrush" Color="#FFB8B8B8" />
          <SolidColorBrush x:Key="SchoologyWarningTextBrush" Color="#FFF0B36B" />
          <SolidColorBrush x:Key="SchoologySuccessTextBrush" Color="#FF78C991" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#FFB8B8B8" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFB8B8B8" />
          <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF5F5F5" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB8B8B8" />
          <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF929292" />
          <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF666666" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF555555" />
          <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#FF777777" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FF454545" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF202428" />
          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF202428" />
          <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF292F34" />
          <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF292F34" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <StaticResource x:Key="SchoologyBlueBrush" ResourceKey="SystemColorHighlightColorBrush" />
          <StaticResource x:Key="SchoologyBlueDarkBrush" ResourceKey="SystemColorHighlightColorBrush" />
          <StaticResource x:Key="SchoologySurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
          <StaticResource x:Key="SchoologySubtleBrush" ResourceKey="SystemColorWindowColorBrush" />
          <StaticResource x:Key="SchoologyDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="SchoologyTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="SchoologyMutedTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
          <StaticResource x:Key="SchoologyWarningTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="SchoologySuccessTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="SystemColorGrayTextColorBrush" />
          <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="SystemColorGrayTextColorBrush" />
          <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="SystemColorGrayTextColorBrush" />
          <StaticResource x:Key="ControlStrokeColorDefaultBrush" ResourceKey="SystemColorButtonTextColorBrush" />
          <StaticResource x:Key="ControlStrokeColorSecondaryBrush" ResourceKey="SystemColorButtonTextColorBrush" />
          <StaticResource x:Key="ControlStrongStrokeColorDefaultBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="CardStrokeColorDefaultBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="CardStrokeColorDefaultSolidBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="DividerStrokeColorDefaultBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="SurfaceStrokeColorDefaultBrush" ResourceKey="SystemColorWindowTextColorBrush" />
          <StaticResource x:Key="CardBackgroundFillColorDefaultBrush" ResourceKey="SystemColorWindowColorBrush" />
          <StaticResource x:Key="SolidBackgroundFillColorBaseBrush" ResourceKey="SystemColorWindowColorBrush" />
          <StaticResource x:Key="SolidBackgroundFillColorSecondaryBrush" ResourceKey="SystemColorWindowColorBrush" />
          <StaticResource x:Key="SubtleFillColorSecondaryBrush" ResourceKey="SystemColorWindowColorBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style TargetType="RichTextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
