<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Schoology.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2026.10.0-port.36</Version>
    <AssemblyVersion>2026.10.0.36</AssemblyVersion>
    <FileVersion>2026.10.0.36</FileVersion>
    <InformationalVersion>2026.10.0-port.36</InformationalVersion>
    <Title>Schoology</Title>
    <Product>Schoology</Product>
    <AssemblyName>Schoology.WinUI</AssemblyName>
    <ApplicationIcon>Assets\\Schoology.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" PrivateAssets="all" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\\logo_schoology.png" />
    <EmbeddedResource Include="Assets\\ic_school.svg" />
    <EmbeddedResource Include="Assets\\ic_sgy_logo.svg" />
    <EmbeddedResource Include="Assets\\ic_qr_code.svg" />
    <EmbeddedResource Include="Assets\\Schoology.ico" />
  </ItemGroup>
</Project>
