<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Schoology.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2026.10.0-port.77</Version>
    <AssemblyVersion>2026.10.0.77</AssemblyVersion>
    <FileVersion>2026.10.0.77</FileVersion>
    <InformationalVersion>2026.10.0-port.77</InformationalVersion>
    <Title>Schoology</Title>
    <Product>Schoology</Product>
    <AssemblyName>Schoology.WinUI</AssemblyName>
    <ApplicationIcon>Assets\\Schoology.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" PrivateAssets="all" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Unpackaged WinUI resolves framework/theme XAML through the generated PRI resource index.
       Keep the index beside the executable so ms-appx theme dictionaries can be resolved. -->
  <Target Name="CopyWinUIResourceIndexToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourceIndex Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Error Condition="'@(_WinUIResourceIndex)' == ''" Text="The WinUI resource index (.pri) was not generated in the build output." />
    <Copy SourceFiles="@(_WinUIResourceIndex)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Assets\\logo_schoology.png" />
    <EmbeddedResource Include="Assets\\ic_school.svg" />
    <EmbeddedResource Include="Assets\\ic_sgy_logo.svg" />
    <EmbeddedResource Include="Assets\\ic_qr_code.svg" />
    <EmbeddedResource Include="Assets\\Schoology.ico" />
  </ItemGroup>
</Project>
