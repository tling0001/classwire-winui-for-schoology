<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Schoology.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2026.10.0-port.126</Version>
    <AssemblyVersion>2026.10.0.126</AssemblyVersion>
    <FileVersion>2026.10.0.126</FileVersion>
    <InformationalVersion>2026.10.0-port.126</InformationalVersion>
    <Title>ClassWire</Title>
    <Product>ClassWire</Product>
    <AssemblyName>ClassWire</AssemblyName>
    <ApplicationIcon>Assets\\ClassWire.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- PDF.js is staged by CI after checkout. WinUI's default item classification can
         treat HTML/JS assets as Content (PRI input) or omit them from publish. Normalize
         the entire tree to explicit None items and copy it beside the executable. -->
    <Content Remove="Assets\\PdfJs\\**\\*" />
    <None Remove="Assets\\PdfJs\\**\\*" />
    <None Include="Assets\\PdfJs\\**\\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="PdfJs\\%(RecursiveDir)%(Filename)%(Extension)"
          ExcludeFromSingleFile="true" />
    <Using Include="Windows.UI.Text.FontWeight" Alias="FontWeight" />
    <Using Include="Windows.UI.Text.FontStyle" Alias="FontStyle" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" PrivateAssets="all" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Unpackaged WinUI resolves framework/theme XAML through the generated PRI resource index.
       Keep the index beside the executable so ms-appx theme dictionaries can be resolved. -->
  <Target Name="CopyWinUIResourceIndexToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourceIndex Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Error Condition="'@(_WinUIResourceIndex)' == ''" Text="The WinUI resource index (.pri) was not generated in the build output." />
    <Copy SourceFiles="@(_WinUIResourceIndex)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Assets\\ic_school.svg" />
    <EmbeddedResource Include="Assets\\ic_person.svg" />
    <EmbeddedResource Include="Assets\\ic_qr_code.svg" />
    <EmbeddedResource Include="Assets\\ClassWire.ico" />
  </ItemGroup>
</Project>
